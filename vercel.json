{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "node scripts/build-static.mjs",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/assets/host.js", "destination": "/api/handler?__path=/assets/host.js" },
    { "source": "/amp/:__rest*", "destination": "/api/handler?__path=/amp/:__rest*" },
    { "source": "/parse/:__rest*", "destination": "/api/handler?__path=/parse/:__rest*" },
    { "source": "/mv/:__rest*", "destination": "/api/handler?__path=/mv/:__rest*" },
    { "source": "/lyrics/:__id", "destination": "/api/handler?__path=/lyrics/:__id" },
    { "source": "/status", "destination": "/api/handler?__path=/status" },
    { "source": "/key", "destination": "/api/handler?__path=/key" },
    { "source": "/(https:/+music\\.apple\\.com/[a-z]{2}/.+)", "destination": "/index.html" },
    { "source": "/new", "destination": "/index.html" },
    { "source": "/new/top-charts", "destination": "/index.html" },
    { "source": "/new/top-charts/:kind", "destination": "/index.html" },
    { "source": "/library", "destination": "/index.html" },
    { "source": "/library/:section", "destination": "/index.html" },
    { "source": "/library/:section/:__id", "destination": "/index.html" }
  ]
}
