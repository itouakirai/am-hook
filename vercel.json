{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "node scripts/build-static.mjs",
  "outputDirectory": "dist",
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "Content-Security-Policy", "value": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'" },
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" }
    ] },
    { "source": "/assets/h/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ],
  "rewrites": [
    { "source": "/assets/host.js", "destination": "/api/handler?__path=/assets/host.js" },
    { "source": "/assets/h/:__rest*", "destination": "/api/handler?__path=/assets/h/:__rest*" },
    { "source": "/amp/:__rest*", "destination": "/api/handler?__path=/amp/:__rest*" },
    { "source": "/parse/:__rest*", "destination": "/api/handler?__path=/parse/:__rest*" },
    { "source": "/mv/:__rest*", "destination": "/api/handler?__path=/mv/:__rest*" },
    { "source": "/lyrics/:__id", "destination": "/api/handler?__path=/lyrics/:__id" },
    { "source": "/status", "destination": "/api/handler?__path=/status" },
    { "source": "/key", "destination": "/api/handler?__path=/key" },
    { "source": "/station/:__rest*", "destination": "/api/handler?__path=/station/:__rest*" },
    { "source": "/(https:/+music\\.apple\\.com/[a-z]{2}/.+)", "destination": "/index.html" },
    { "source": "/new", "destination": "/index.html" },
    { "source": "/new/top-charts", "destination": "/index.html" },
    { "source": "/new/top-charts/:kind", "destination": "/index.html" },
    { "source": "/settings", "destination": "/index.html" },
    { "source": "/radio", "destination": "/index.html" },
    { "source": "/home", "destination": "/index.html" },
    { "source": "/home/see-all/:__id", "destination": "/index.html" },
    { "source": "/library", "destination": "/index.html" },
    { "source": "/library/:section", "destination": "/index.html" },
    { "source": "/library/:section/:__id", "destination": "/index.html" }
  ]
}
